# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Netlify, add this variable to your Environment Variables setting dashboard 
# to keep your API keys fully hidden from the client browser and mobile webviews!
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# VITE_GEMINI_API_KEY: Fallback client key (uncomment ONLY for local standalone test)
# VITE_GEMINI_API_KEY=""

# VITE_USE_PROXY: Set to "true" to force proxying to Netlify serverless functions locally (optional)
# VITE_USE_PROXY="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
